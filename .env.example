# Rails API base URL including the version prefix, e.g. https://api.example.com/api/v1
API_URL=http://localhost:3001/api/v1

# Same value as INTERNAL_API_SECRET on the API. Lets the API rate-limit by the
# real client IP instead of this server's IP.
INTERNAL_API_SECRET=

# Paddle Billing (client side)
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID=
# Shown on the subscription page; keep in sync with the Paddle price.
NEXT_PUBLIC_PRO_PRICE_LABEL=$7

# Public site URL (canonical links, sitemap, social previews)
NEXT_PUBLIC_SITE_URL=https://dashclue.com

# Blog content (Sanity CMS). Leave unset to show an empty blog.
SANITY_PROJECT_ID=
SANITY_DATASET=production
